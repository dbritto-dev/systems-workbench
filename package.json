{
  "name": "systems-workbench",
  "private": true,
  "description": "Interactive lessons that teach systems concepts through one simulated isometric machine per idea.",
  "type": "module",
  "scripts": {
    "dev": "node tools/export-lessons.mjs && astro dev",
    "build": "node tools/export-lessons.mjs && astro build",
    "preview": "astro preview",
    "export:lessons": "node tools/export-lessons.mjs",
    "check:site": "node tools/site-check.cjs",
    "lessons": "node tools/build-all.mjs",
    "previews": "node workbench/collection/previews.cjs",
    "gallery": "node workbench/parts-gallery.mjs",
    "shot": "node tools/shot.cjs",
    "compare": "node tools/compare.cjs"
  },
  "devDependencies": {
    "astro": "^7.4.5",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.47.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.16.1"
