---
// The collection: every lesson as a card, with search and area filters. Laid out with astryx-astro's components
// (Heading, Text, Grid of ClickableCards, EmptyState); the stats strip and the cards' previews are ours.
// The first paint waits until the first two cards are parsed (Base's paintAfter), so a slow parse never paints the
// header alone and then the toolbar and cards: what is above the fold appears at once, settled.
import Base from "../../layouts/Base.astro";
import HStack from "astryx-astro/components/Stack/HStack.astro";
import Link from "astryx-astro/components/Link/Link.astro";
import Heading from "astryx-astro/components/Text/Heading.astro";
import Text from "astryx-astro/components/Text/Text.astro";
import Grid from "astryx-astro/components/Grid/Grid.astro";
import EmptyState from "astryx-astro/components/EmptyState/EmptyState.astro";
import Button from "astryx-astro/components/Button/Button.astro";
import Switches from "../../components/Switches.astro";
import LinkedText from "../../components/LinkedText.astro";
import Toolbar from "../../components/collection/Toolbar.astro";
import LessonCard from "../../components/collection/LessonCard.astro";
import PreviewDialog from "../../components/collection/PreviewDialog.astro";
import { langParams, type Locale } from "../../i18n";
import { useUi } from "../../i18n/ui";
import { allLessons, two } from "../../lib/lessons";
import "virtual:tokens.css";
import "../../styles/collection.css";

export const getStaticPaths = () => langParams().map((params) => ({ params }));
const locale = (Astro.currentLocale ?? "en") as Locale;
const ui = useUi(locale);
const lessons = await allLessons();
const experiments = lessons.reduce((s, l) => s + l.page.predict.experiments.length, 0);
const questions = lessons.reduce((s, l) => s + l.page.explain.questions.length, 0);
const REPO = "https://github.com/dbritto-dev/systems-workbench";
// The card whose end the first paint waits for (LessonCard.astro's id): the second, the last one above the fold.
const firstRow = `lesson-${two(lessons[Math.min(1, lessons.length - 1)].n)}`;
const INDEX = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}search-index.json`;
---
<Base locale={locale} title={ui("site.name")} description={ui("site.description")} path="" paintAfter={firstRow}>
  <Fragment slot="head">
    <meta name="claude:viewport-fit-sides" content="cover" />
  </Fragment>
  <div class="wrap">
    <header class="masthead">
    <HStack class="top" justify="between" align="center" gap={3}><span>{ui("site.tagline")}</span><Switches locale={locale} path="" size="md" /></HStack>
    <div class="head">
      <div>
        <Heading level={1} class="title">{ui("site.name")}</Heading>
        <Text as="p" class="intro" color="secondary">{ui("site.intro")}</Text>
      </div>
      <div class="stats" role="list" aria-label={ui("stats.label")}>
        <div role="listitem"><b>{lessons.length}</b> <span>{ui("stats.lessons")}</span></div>
        <div role="listitem"><b>{experiments}</b> <span>{ui("stats.experiments")}</span></div>
        <div role="listitem"><b>{questions}</b> <span>{ui("stats.questions")}</span></div>
      </div>
    </div>
    </header>
    <lesson-collection index={INDEX} locale={locale}>
    <Toolbar locale={locale} lessons={lessons} />
    <main id="lessons">
      <Grid class="cards" columns={{ minWidth: 360, max: 2 }} gap={5} data-cards>
        {lessons.map((lesson, i) => <LessonCard lesson={lesson} locale={locale} eager={i < 2} />)}
        <EmptyState class="empty" data-empty hidden title={ui("search.none")} description=" " headingLevel={2}>
          <Fragment slot="actions">
            <Button label={ui("search.showAll")} data-all />
            <Button label={ui("search.clear")} data-clear />
          </Fragment>
        </EmptyState>
      </Grid>
    </main>
    </lesson-collection>
    <footer>
      <LinkedText html={ui("footer.collection")} /> · <Link href={`${import.meta.env.BASE_URL}workbench/parts-gallery/`} color="inherit" type="inherit" hasUnderline>{ui("footer.gallery")}</Link> · <Link href={REPO} color="inherit" type="inherit" hasUnderline>{ui("footer.source")}</Link>
    </footer>
  </div>
  <PreviewDialog locale={locale} index={INDEX} />
  <script>
    import "../../elements/lesson-collection";
  </script>
</Base>
