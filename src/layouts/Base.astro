---
// Every page: document head (title, description, language alternates), the theme set before first paint,
// old ?lang= links sent to the right language's URL, and the UX foundation: styles/ux.css (focus ring, motion,
// disabled, target sizes) and the input modality on <html data-astryx-modality>, Astryx's, heard from the first key or
// tap (runtime/modality.ts: startModality, inlined in the head, starts the tracker Astryx's components share). With
// skipTo, a "Skip to content" link to that id is the first Tab stop (styles/chrome.css). It is ours: Astryx draws one
// only inside AppShell, which would take over the page's frame.
// Fonts: the faces a page draws above the fold are preloaded, so the first paint already uses them instead of
// swapping from the fallback (a swap shifts text sideways): headings 600, text 400, and the mono weights the page
// names (lessons label in 400 and 500; the collection only in 500).
// paintAfter: the first paint waits until the element with that id is parsed (a render-blocking
// <link rel="expect">), so it shows everything above the fold at once. The parser sometimes yields at an inline
// script near the top (the switches' markTheme), and a paint there showed the top bar alone, the rest a frame
// later. Browsers without rel="expect" paint as before.
// Components: astryx-astro (Astryx's components in Astro) in our "workbench" theme: its stylesheet (reset, tokens and
// shared rules, all in CSS layers below ours), the theme (styles/astryx-workbench.css) and data-astryx-theme on
// <html>. Light or dark is data-theme on <html>, as before; the theme's colours follow it. The order of the CSS
// layers (styles/layers.css) is inlined first thing in <head>: the bundled stylesheets come later, and the first
// layer named fixes its place, so that order holds whichever stylesheet loads first.
import { getRelativeLocaleUrl } from "astro:i18n";
import { Font } from "astro:assets";
import { LOCALES, type Locale } from "../i18n";
import layerOrder from "../styles/layers.css?raw";
import "astryx-astro/astryx.css";
import "../styles/astryx-workbench.css";
import "../styles/fonts.css";
import "../styles/ux.css";
import "../styles/chrome.css";
import { useUi } from "../i18n/ui";
import { startModality } from "../runtime/modality";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** This page's path without the language prefix, e.g. "lessons/cache/" ("" for the home page). */
  path: string;
  bodyClass?: string;
  /** The id of the page's main content: adds a "Skip to content" link to it as the first Tab stop. */
  skipTo?: string;
  /** Inconsolata weights to preload (the ones the page uses above the fold). */
  monoWeights?: number[];
  /** The id of the last element above the fold: the first paint waits until it is parsed. */
  paintAfter?: string;
}
const { locale, title, description, path, bodyClass, skipTo, monoWeights = [500], paintAfter } = Astro.props;
const ui = useUi(locale);
const canonical = new URL(getRelativeLocaleUrl(locale, path), Astro.site);
---
<!doctype html>
<html lang={locale} data-lang={locale} data-astryx-theme="workbench" data-astryx-modality="keyboard">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <style is:inline set:html={layerOrder} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {paintAfter && <link rel="expect" href={`#${paintAfter}`} blocking="render" />}
    <Font cssVariable="--font-heading" preload={[{ weight: 600 }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-mono" preload={monoWeights.map((weight) => ({ weight }))} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(getRelativeLocaleUrl(l, path), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl("en", path), Astro.site)} />
    <script is:inline>
      (function () {
        try { var t = localStorage.getItem("workbench-theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) {}
        try {
          var u = new URL(location.href), want = u.searchParams.get("lang"), here = document.documentElement.lang;
          if ((want === "es" || want === "en") && want !== here) {
            var alt = document.querySelector('link[rel="alternate"][hreflang="' + want + '"]');
            if (alt) { u.searchParams.delete("lang"); location.replace(alt.getAttribute("href") + u.search + u.hash); }
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline set:html={`(${startModality})(document)`} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {skipTo && <a class="skip-link" href={`#${skipTo}`}>{ui("chrome.skip")}</a>}
    <slot />
  </body>
</html>
