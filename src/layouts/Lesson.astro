---
// A lesson page: the top navigation (the way back, language and theme), then <main>: the header, the machine
// (figure + panel), predict-then-run cards, explain-back questions and related lessons; then the footer. Base.astro
// puts a "Skip to content" link to <main> first. The chrome's look and link behaviour is styles/chrome.css.
// The figure's still frame is plain HTML/SVG, so the page reads and prints without JavaScript. <wb-lesson> holds the
// machine and the experiments and loads the lesson's live code (the model and the animation) as they come into view.
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "./Base.astro";
import Switches from "../components/Switches.astro";
import Experiments from "../components/lesson/Experiments.astro";
import Questions from "../components/lesson/Questions.astro";
import FigurePlate from "../components/lesson/FigurePlate.astro";
import Panel from "../components/lesson/Panel.astro";
import { pick, type Locale } from "../i18n";
import { useUi } from "../i18n/ui";
import { plain, conceptOf, two, type Lesson } from "../lib/lessons";
import { markNewTabLinks } from "../lib/links";
import "virtual:workbench.css";
import "../styles/lesson.css";

interface Props { lesson: Lesson; locale: Locale; related: Lesson[] }
const { lesson, locale, related } = Astro.props;
const p = lesson.page;
const def = lesson.def;
const ui = useUi(locale);
const L = (v: Parameters<typeof pick<string>>[0]) => pick(v, locale);
const path = `lessons/${lesson.slug}/`;
---
<Base locale={locale} title={plain(p.title, locale)} description={plain(p.lede, locale).slice(0, 300)} path={path} bodyClass={p.litFill ? "iso lit-fill" : "iso"} skipTo="main" paintAfter="machine" monoWeights={[400, 500]}>
  <Fragment slot="head">{p.css && <Fragment set:html={`<style>${p.css}</style>`} />}</Fragment>
  <div class="page">
  <header class="topbar">
    <nav class="topnav" aria-label={ui("chrome.topNav")}>
      <a class="back" href={getRelativeLocaleUrl(locale)}><span aria-hidden="true">←</span>{ui("lesson.back")}</a>
      <Switches locale={locale} path={path} nav={false} />
    </nav>
  </header>
  <main id="main">
    <header class="lesson-head">
      <div class="eyebrow" set:html={L(p.eyebrow)} />
      <h1 set:html={L(p.title)} />
      <p class="lede" set:html={L(p.lede)} />
      <nav aria-label={ui("chrome.onPage")}>
        <ul class="parts">
          <li><a href="#machine">{ui("lesson.parts.machine")}</a></li>
          <li><a href="#predict">{ui("lesson.parts.predict")}</a></li>
          <li><a href="#explain">{ui("lesson.parts.explain")}</a></li>
        </ul>
      </nav>
    </header>

    <wb-lesson slug={lesson.slug}>
    <section id="machine">
      <div class="section-head"><span class="eyebrow">01</span><h2>{ui("lesson.machine")}</h2><p set:html={L(p.machine.intro)} /></div>
          <FigurePlate plate={def.machine.plate} svg={def.machine.svg} locale={locale} />
          <Panel stats={def.machine.stats} controls={def.machine.controls} note={def.machine.note} locale={locale} />
    </section>

    <section id="predict">
      <div class="section-head"><span class="eyebrow">02</span><h2>{ui("lesson.predict")}</h2><p set:html={L(p.predict.intro)} /></div>
      <Experiments locale={locale} slug={lesson.slug} experiments={p.predict.experiments} />
    </section>
    <script type="application/json" data-lesson-data set:html={JSON.stringify(def.data).replace(/</g, "\\u003c")} />
    </wb-lesson>

    <section id="explain">
      <div class="section-head"><span class="eyebrow">03</span><h2>{ui("lesson.explain")}</h2><p set:html={p.explain.intro ? L(p.explain.intro) : ui("lesson.explainIntro")} /></div>
      <Questions locale={locale} questions={p.explain.questions} />
    </section>

    {related.length > 0 && (
      <nav class="related" aria-labelledby="related-title">
        <h2 id="related-title">{ui("lesson.related")}</h2>
        <ul>
          {related.map((r) => (
            <li><a href={getRelativeLocaleUrl(locale, `lessons/${r.slug}/`)}><span class="n">{two(r.n)}</span>{plain(conceptOf(r), locale)}</a></li>
          ))}
        </ul>
      </nav>
    )}

  </main>
  <footer set:html={markNewTabLinks(p.footer ? L(p.footer) : ui("lesson.footer"), ui("chrome.newTab"))} />
  </div>
  <script>
    import "../elements/wb-lesson";
  </script>
</Base>
