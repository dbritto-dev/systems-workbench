---
// Under the figure: the stats strip <wb-stats>, one <wb-stat> per figure (written by the live code), and the controls
// <wb-controls>, one <wb-control> row each: a segmented choice <wb-seg> (the speed control is one), a row of action
// buttons <wb-actions> (one maybe marked primary), or a text box. The elements are in src/elements/wb-controls.ts.
import { pick, type Locale } from "../../i18n";
import type { Control } from "../../lessons/types";

interface Props { stats: [string, Parameters<typeof pick<string>>[0], Parameters<typeof pick<string>>[0]?][]; controls: Control[]; note?: Parameters<typeof pick<string>>[0]; locale: Locale }
const { stats, controls, note, locale } = Astro.props;
const L = (v: Parameters<typeof pick<string>>[0]) => pick(v, locale);
const SPEEDS: [number, string][] = [[0.5, "×0.5"], [1, "×1"], [3, "×3"], [8, "×8"]];
const segs = controls.map((c) =>
  "seg" in c ? { name: c.seg, label: L(c.label), options: c.options, value: c.value, multiple: !!c.multiple }
  : "speed" in c ? { name: "speed", label: L({ en: "Speed", es: "Velocidad" }), options: c.options ?? SPEEDS, value: c.value ?? 1, multiple: false }
  : null,
);
---
<div class="panel">
  <wb-stats class="stats" data-stats>
    {stats.map(([key, label, initial = "0"]) => <wb-stat class="stat" key={key}><b data-s={key}>{L(initial)}</b><span>{L(label)}</span></wb-stat>)}
  </wb-stats>
  <wb-controls class="controls">
    {controls.map((c, i) => {
      const s = segs[i];
      if (s) return (
        <wb-control class="control" for={c.for} hidden={c.hidden || undefined}><span>{s.label}</span>
          <wb-seg class="seg" role="group" aria-label={s.label} name={s.name} value={s.multiple ? undefined : String(s.value)} multiple={s.multiple || undefined}>
            {s.options.map(([value, text]) => <button type="button" data-set={s.name} data-value={String(value)} aria-pressed={String(s.multiple ? String(s.value).split(" ").includes(String(value)) : String(value) === String(s.value))}>{L(text)}</button>)}
          </wb-seg>
        </wb-control>
      );
      if ("actions" in c) return (
        <wb-control class="control" for={c.for} hidden={c.hidden || undefined}><span>{L(c.label)}</span>
          <wb-actions class="actions">{c.actions.map(([act, text, opts]) => <button class={opts?.primary ? "btn primary" : "btn"} type="button" data-act={act}>{L(text)}</button>)}</wb-actions>
        </wb-control>
      );
      if ("input" in c) return (
        <wb-control class="control" for={c.for} hidden={c.hidden || undefined}><span>{L(c.label)}</span>
          <input class="text-in" type="text" data-input={c.input} placeholder={c.placeholder && L(c.placeholder)} aria-label={c.aria && L(c.aria)} maxlength={c.maxLength} autocomplete="off" spellcheck="false" />
        </wb-control>
      );
    })}
  </wb-controls>
  {note && <p class="note panel-note">{L(note)}</p>}
</div>
<style is:global>
  .panel-note { padding: 0 12px 12px; margin: 0; }
  .controls > .control[hidden] { display: none; }
  wb-stat, wb-control { display: block; }
  .text-in { font: inherit; font-size: 13px; padding: 6px 8px; min-width: 0; width: 100%; max-width: 280px; background: transparent; color: inherit; border: 1px solid var(--anatomy-lo); border-radius: 0; }
</style>
