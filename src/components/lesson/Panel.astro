---
// Under the figure: the stats strip <wb-stats>, one <wb-stat> per figure (written by the live code), and the controls
// <wb-controls>, one <wb-control> row each, labelled by its visible label:
//   - a one-of-N choice <wb-seg role="radiogroup"> (the speed control is one): option buttons with role="radio" and
//     aria-checked, the selected one ink-filled;
//   - a toggle group <wb-seg multiple role="group">: option buttons with aria-pressed;
//   - a row of action buttons <wb-actions role="group"> (one maybe marked primary; Pause is a toggle, aria-pressed);
//   - a text box, with a real <label>.
// Everything that shows is in the HTML; src/elements/wb-controls.ts adds the keyboard (one Tab stop and arrow keys
// for a one-of-N choice), the sliding selected surface, press feedback and disabled reasons.
import { pick, type Locale } from "../../i18n";
import type { Control } from "../../lessons/types";

interface Props { stats: [string, Parameters<typeof pick<string>>[0], Parameters<typeof pick<string>>[0]?][]; controls: Control[]; note?: Parameters<typeof pick<string>>[0]; locale: Locale }
const { stats, controls, note, locale } = Astro.props;
const L = (v: Parameters<typeof pick<string>>[0]) => pick(v, locale);
const SPEEDS: [number, string][] = [[0.5, "×0.5"], [1, "×1"], [3, "×3"], [8, "×8"]];
const segs = controls.map((c) =>
  "seg" in c ? { name: c.seg, label: L(c.label), options: c.options, value: c.value, multiple: !!c.multiple }
  : "speed" in c ? { name: "speed", label: L({ en: "Speed", es: "Velocidad" }), options: c.options ?? SPEEDS, value: c.value ?? 1, multiple: false }
  : null,
);
// The panel is once per page, so its row ids only need to be unique within it.
const id = (i: number, part: string) => `wb-c${i}-${part}`;
const on = (s: NonNullable<(typeof segs)[number]>, value: string | number) =>
  s.multiple ? String(s.value).split(" ").includes(String(value)) : String(value) === String(s.value);
---
<div class="panel">
  <wb-stats class="stats" data-stats>
    {stats.map(([key, label, initial = "0"]) => <wb-stat class="stat" key={key}><b data-s={key}>{L(initial)}</b><span>{L(label)}</span></wb-stat>)}
  </wb-stats>
  <wb-controls class="controls">
    {controls.map((c, i) => {
      const s = segs[i];
      if (s) return (
        <wb-control class="control" for={c.for} hidden={c.hidden || undefined}><span id={id(i, "label")}>{s.label}</span>
          {s.multiple ? (
            <wb-seg class="seg" role="group" aria-labelledby={id(i, "label")} name={s.name} multiple>
              {s.options.map(([value, text]) => <button type="button" data-set={s.name} data-value={String(value)} aria-pressed={String(on(s, value))}>{L(text)}</button>)}
            </wb-seg>
          ) : (
            <wb-seg class="seg" role="radiogroup" aria-labelledby={id(i, "label")} name={s.name} value={String(s.value)}>
              {s.options.map(([value, text]) => <button type="button" role="radio" data-set={s.name} data-value={String(value)} aria-checked={String(on(s, value))}>{L(text)}</button>)}
            </wb-seg>
          )}
        </wb-control>
      );
      if ("actions" in c) return (
        <wb-control class="control" for={c.for} hidden={c.hidden || undefined}><span id={id(i, "label")}>{L(c.label)}</span>
          <wb-actions class="actions" role="group" aria-labelledby={id(i, "label")}>{c.actions.map(([act, text, opts]) => (
            <button class={opts?.primary ? "btn primary ux-hit" : "btn ux-hit"} type="button" data-act={act} aria-pressed={act === "pause" ? "false" : undefined}>{L(text)}</button>
          ))}</wb-actions>
        </wb-control>
      );
      if ("input" in c) return (
        <wb-control class="control" for={c.for} hidden={c.hidden || undefined}><label for={id(i, "input")}>{L(c.label)}</label>
          <input class="text-in" id={id(i, "input")} type="text" data-input={c.input} placeholder={c.placeholder && L(c.placeholder)} aria-describedby={c.aria && id(i, "desc")} maxlength={c.maxLength} autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="done" />
          {c.aria && <span class="wb-vh" id={id(i, "desc")}>{L(c.aria)}</span>}
        </wb-control>
      );
    })}
  </wb-controls>
  {note && <p class="note panel-note">{L(note)}</p>}
</div>
<style is:global>
  .panel-note { padding: 0 12px 12px; margin: 0; }
  .controls > .control[hidden] { display: none; }
  wb-stat, wb-control { display: block; }
</style>
