---
// Explain-it-back questions, each with what a good answer covers behind a native <details> (Astryx's Collapsible,
// without JavaScript): the summary is the trigger (Enter and Space toggle it, the browser exposes the expanded
// state), the answer lands at once, and a decorative chevron at the end turns from down (closed) to up (open). The
// questions are independent disclosures: each its own Tab stop, no arrow keys between them.
import { pick, type Bi, type Locale } from "../../i18n";
import { useUi } from "../../i18n/ui";

interface Props { locale: Locale; questions: [Bi, Bi][] }
const { locale, questions } = Astro.props;
const ui = useUi(locale);
---
{questions.map(([q, a], i) => (
  <details>
    <summary><span class="n">{ui("q.n", { i: i + 1 })}</span><span class="q">{pick(q, locale)}</span></summary>
    <div class="answer"><span class="eyebrow">{ui("q.covers")}</span>{pick(a, locale)}</div>
  </details>
))}
