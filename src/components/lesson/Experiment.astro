---
// One predict-then-run card: a <wb-experiment> (src/elements/wb-experiment.ts) around an Astryx Card, with its
// build-time result (in the page's language) and the settings its Watch button sends to the live code.
// The predictions are a radiogroup of Astryx SelectableCards (type="radio"), named by the question above them: each
// card's first child is a visually hidden native radio, so the group is one Tab stop and the arrows move and select;
// Astryx makes the whole card clickable. Without JavaScript the radio covers its card (lesson CSS, keyed on the
// group not being data-shuffled), so a card is still clickable.
// The options are shuffled on every page load by shuffleChoices() (src/elements/shuffle-choices.ts). The card
// carries a copy of that function and calls it on its own options as soon as they are parsed, before the card is
// first painted, so the order never visibly jumps (the element's module only runs after the whole page is parsed).
// The copy is scoped to this card: no global, and it touches nothing outside the card. The order written here is the
// one shown without JavaScript: the right option sits at a place hashed from the lesson and experiment ids, so even
// that order doesn't give it away. data-choice keeps each option's index in page.ts, which `answer` refers to.
// Run is an Astryx Button, disabled (aria-disabled, still focusable) with its reason, "Pick a prediction first", as
// its Tooltip; Watch is a Button. The result is rendered here, hidden until the card is run: the verdict's place,
// the bars as Astryx ProgressBars (value = the share, the value label = the result's text, the "after" bar in the
// accent), and the explanation.
import Card from "astryx-astro/components/Card/Card.astro";
import HStack from "astryx-astro/components/Stack/HStack.astro";
import VStack from "astryx-astro/components/Stack/VStack.astro";
import SelectableCard from "astryx-astro/components/SelectableCard/SelectableCard.astro";
import Button from "astryx-astro/components/Button/Button.astro";
import ProgressBar from "astryx-astro/components/ProgressBar/ProgressBar.astro";
import { pick, type Locale } from "../../i18n";
import { useUi } from "../../i18n/ui";
import type { Lesson } from "../../lib/lessons";
import type { ExperimentResult, ResultBar } from "../../lessons/types";
import { shuffleChoices } from "../../elements/shuffle-choices";

type Exp = Lesson["page"]["predict"]["experiments"][number];
interface Props { locale: Locale; slug: string; experiment: Exp; index: number; count: number }
const { locale, slug, experiment: e, index, count } = Astro.props;
const hash = (s: string) => { let h = 2166136261; for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };
const order = e.options.map((_, j) => j).filter((j) => j !== e.answer);
order.splice(hash(`${slug}:${e.id}`) % e.options.length, 0, e.answer);
const ui = useUi(locale);
const L = (v: Parameters<typeof pick<string>>[0]) => pick(v, locale);
const json = (v: unknown) => JSON.stringify(v).replace(/</g, "\\u003c");
const groups = (r: ExperimentResult | undefined): { title: string; bars: ResultBar[] }[] =>
  !r ? [] : "groups" in r ? r.groups.map((g) => ({ title: L(g.title), bars: g.bars })) : [{ title: "", bars: r.bars }];
const id = `wb-exp${index + 1}`;
---
<wb-experiment class="exp" role="article" aria-labelledby={`${id}-title`} data-exp={e.id} exp={e.id} answer={String(e.answer)}>
  <Card class="exp-card">
    <HStack class="exp-head" justify="between" align="end" gap={3} wrap="wrap"><h3 id={`${id}-title`}>{index + 1}. {L(e.title)}</h3><span class="eyebrow">{ui("exp.count", { i: index + 1, n: count })}</span></HStack>
    <div class="exp-change">{L(e.change)}</div>
    <div class="exp-q" id={`${id}-q`}>{L(e.question)}</div>
    <VStack class="choices" role="radiogroup" aria-labelledby={`${id}-q`} gap={1.5}>
      {order.map((j, k) => (
        <SelectableCard class="choice" type="radio" name={`${id}-prediction`} value={String(j)} label={L(e.options[j])} data-choice={j}><span class="mark" aria-hidden="true">{"ABCDE"[k]}</span><span class="text">{L(e.options[j])}</span></SelectableCard>
      ))}
    </VStack>
    <script is:inline set:html={`(${shuffleChoices})(document.currentScript.previousElementSibling)`} />
    <HStack class="actions" gap={2} wrap="wrap">
      <Button label={ui("exp.run")} variant="primary" isDisabled tooltip={ui("exp.pickFirst")} data-run class="ux-hit" />
      <Button label={ui("exp.watch")} data-watch class="ux-hit" />
    </HStack>
    <div class="result">
      <div class="verdict" data-outcome></div>
      <div class="bars">
        {groups(e.result).map((g) => (
          <Fragment>
            {g.title && <div class="bar-group">{g.title}</div>}
            {g.bars.map(([label, share, text, after]) => (
              <ProgressBar class="bar" label={L(label)} value={Math.max(1, Math.round(100 * share))} hasValueLabel formatValueLabel={() => L(text)} variant={after ? "accent" : "neutral"} />
            ))}
          </Fragment>
        ))}
      </div>
      <p>{L(e.why)}</p>
    </div>
    {e.result && <script type="application/json" data-result set:html={json({ verdict: L(e.result.verdict) })} />}
    {e.watch !== undefined && <script type="application/json" data-watch-settings set:html={json(e.watch)} />}
  </Card>
</wb-experiment>
