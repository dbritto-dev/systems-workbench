---
// One predict-then-run card: a <wb-experiment> (src/elements/wb-experiment.ts) with its build-time result (in the
// page's language) and the settings its Watch button sends to the live code.
// The predictions are a single-choice group of selectable cards (Astryx's SelectableCard): each card is a <label>
// whose first child is a visually hidden native radio, so the group is one Tab stop, the arrows move and select, the
// whole card is clickable, and it all works without JavaScript. The question above the cards names the group.
// The options are shuffled on every page load by the element's own shuffleChoices(). The card carries a copy of that
// function and calls it on its own options as soon as they are parsed, before the card is first painted, so the order
// never visibly jumps (the element's module only runs after the whole page is parsed). The copy is scoped to this card:
// no global, and it touches nothing outside the card. The order written here is the one shown without JavaScript: the
// right option sits at a place hashed from the lesson and experiment ids, so even that order doesn't give it away.
// data-choice keeps each option's index in page.ts, which `answer` refers to.
// Run starts disabled (aria-disabled, still focusable) with its reason, "Pick a prediction first", as a tooltip
// written here and opened by ./wb-button.ts on hover, keyboard focus or a tap.
import { pick, type Locale } from "../../i18n";
import { useUi } from "../../i18n/ui";
import type { Lesson } from "../../lib/lessons";
import type { ExperimentResult, ResultBar } from "../../lessons/types";
import { shuffleChoices } from "../../elements/wb-experiment";

type Exp = Lesson["page"]["predict"]["experiments"][number];
interface Props { locale: Locale; slug: string; experiment: Exp; index: number; count: number }
const { locale, slug, experiment: e, index, count } = Astro.props;
const hash = (s: string) => { let h = 2166136261; for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };
const order = e.options.map((_, j) => j).filter((j) => j !== e.answer);
order.splice(hash(`${slug}:${e.id}`) % e.options.length, 0, e.answer);
const ui = useUi(locale);
const L = (v: Parameters<typeof pick<string>>[0]) => pick(v, locale);
const json = (v: unknown) => JSON.stringify(v).replace(/</g, "\\u003c");
const bars = (list: ResultBar[]) => list.map(([label, share, text, after]) => (after ? [L(label), share, L(text), true] : [L(label), share, L(text)]));
const resultOf = (r: ExperimentResult | undefined) =>
  !r ? null : "groups" in r ? { verdict: L(r.verdict), groups: r.groups.map((g) => ({ title: L(g.title), bars: bars(g.bars) })) } : { verdict: L(r.verdict), bars: bars(r.bars) };
const id = `wb-exp${index + 1}`;
---
<wb-experiment class="exp" role="article" aria-labelledby={`${id}-title`} data-exp={e.id} exp={e.id} answer={String(e.answer)}>
  <div class="exp-head"><h3 id={`${id}-title`}>{index + 1}. {L(e.title)}</h3><span class="eyebrow">{ui("exp.count", { i: index + 1, n: count })}</span></div>
  <div class="exp-change">{L(e.change)}</div>
  <div class="exp-q" id={`${id}-q`}>{L(e.question)}</div>
  <div class="choices" role="radiogroup" aria-labelledby={`${id}-q`}>
    {order.map((j, k) => (
      <label class="choice" data-choice={j}><input type="radio" name={`${id}-prediction`} value={String(j)} autocomplete="off" /><span class="mark" aria-hidden="true">{"ABCDE"[k]}</span><span class="text">{L(e.options[j])}</span></label>
    ))}
  </div>
  <script is:inline set:html={`(${shuffleChoices})(document.currentScript.previousElementSibling)`} />
  <div class="actions">
    <button class="btn primary ux-hit" type="button" data-run aria-disabled="true" aria-describedby={`${id}-why-off`} data-wb-tip={`${id}-why-off`}>{ui("exp.run")}</button>
    <span class="wb-tip" role="tooltip" id={`${id}-why-off`} popover="manual">{ui("exp.pickFirst")}</span>
    <button class="btn ux-hit" type="button" data-watch>{ui("exp.watch")}</button>
  </div>
  <div class="result">
    <div class="verdict" data-outcome></div>
    <div class="bars" data-bars></div>
    <p>{L(e.why)}</p>
  </div>
  {e.result && <script type="application/json" data-result set:html={json(resultOf(e.result))} />}
  {e.watch !== undefined && <script type="application/json" data-watch-settings set:html={json(e.watch)} />}
</wb-experiment>
