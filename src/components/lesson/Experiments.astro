---
// The lesson's five predict-then-run cards. Each card is self-contained: see Experiment.astro.
import type { Locale } from "../../i18n";
import type { Lesson } from "../../lib/lessons";
import Experiment from "./Experiment.astro";

interface Props { locale: Locale; slug: string; experiments: Lesson["page"]["predict"]["experiments"] }
const { locale, slug, experiments } = Astro.props;
---
{experiments.map((e, i) => <Experiment locale={locale} slug={slug} experiment={e} index={i} count={experiments.length} />)}
