---
// The five predict-then-run cards, each a <wb-experiment> (src/elements/wb-experiment.ts). A card carries its
// build-time result (in the page's language) and the settings its Watch button sends to the live code.
import { pick, type Locale } from "../../i18n";
import { useUi } from "../../i18n/ui";
import type { Lesson } from "../../lib/lessons";
import type { ExperimentResult, ResultBar } from "../../lessons/types";

interface Props { locale: Locale; experiments: Lesson["page"]["predict"]["experiments"] }
const { locale, experiments } = Astro.props;
const ui = useUi(locale);
const L = (v: Parameters<typeof pick<string>>[0]) => pick(v, locale);
const json = (v: unknown) => JSON.stringify(v).replace(/</g, "\\u003c");
const bars = (list: ResultBar[]) => list.map(([label, share, text, after]) => (after ? [L(label), share, L(text), true] : [L(label), share, L(text)]));
const resultOf = (r: ExperimentResult | undefined) =>
  !r ? null : "groups" in r ? { verdict: L(r.verdict), groups: r.groups.map((g) => ({ title: L(g.title), bars: bars(g.bars) })) } : { verdict: L(r.verdict), bars: bars(r.bars) };
---
{experiments.map((e, i) => (
  <wb-experiment class="exp" role="article" data-exp={e.id} exp={e.id} answer={String(e.answer)}>
    <div class="exp-head"><h3>{i + 1}. {L(e.title)}</h3><span class="eyebrow">{ui("exp.count", { i: i + 1, n: experiments.length })}</span></div>
    <div class="exp-change">{L(e.change)}</div>
    <div class="exp-q">{L(e.question)}</div>
    <div class="choices" role="group" aria-label={ui("exp.prediction")}>
      {e.options.map((o, j) => (
        <button type="button" class="choice" data-choice={j} aria-pressed="false"><span class="mark">{"ABCDE"[j]}</span><span>{L(o)}</span></button>
      ))}
    </div>
    <div class="actions"><button class="btn primary" type="button" data-run disabled>{ui("exp.pick")}</button><button class="btn" type="button" data-watch>{ui("exp.watch")}</button></div>
    <div class="result" aria-live="polite">
      <div class="verdict" data-outcome></div>
      <div class="bars" data-bars></div>
      <p>{L(e.why)}</p>
    </div>
    {e.result && <script type="application/json" data-result set:html={json(resultOf(e.result))} />}
    {e.watch !== undefined && <script type="application/json" data-watch-settings set:html={json(e.watch)} />}
  </wb-experiment>
))}
