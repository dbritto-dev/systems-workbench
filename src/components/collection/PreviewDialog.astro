---
// A closer look at a lesson without leaving the collection: the machine large, the lede, the five experiments.
// <lesson-preview> (src/elements/lesson-preview.ts) fills it in from the search index, fetched the first time a
// preview opens. A native modal <dialog> (Astryx's Dialog): named by its title and described by the lede, focus moves
// in when it opens, Escape or a press on the backdrop closes it, focus goes back to the button that opened it, and
// while it is open announcements are read from inside it (runtime/announce.ts).
import { useUi } from "../../i18n/ui";
import type { Locale } from "../../i18n";

interface Props { locale: Locale; index: string }
const { locale, index } = Astro.props;
const ui = useUi(locale);
---
<lesson-preview index={index} locale={locale}>
<dialog id="preview" aria-labelledby="dlg-title" aria-describedby="dlg-lede">
  <div class="dlg">
    <div class="dlg-shot"><span class="plate-corner tl" data-d="no"></span><span class="plate-corner tr" data-d="machine"></span><img class="on-light" data-d="light" alt="" /><img class="on-dark" data-d="dark" alt="" /></div>
    <div class="dlg-text">
      <div class="meta"><span data-d="area"></span><span data-d="concept"></span></div>
      <h2 id="dlg-title" data-d="title"></h2>
      <p id="dlg-lede" data-d="lede"></p>
      <ol data-d="exps"></ol>
      <div class="dlg-actions"><span class="counts" data-d="counts"></span><span class="card-actions"><button type="button" class="btn" data-close>{ui("dialog.close")}</button><a class="btn primary" data-d="url">{ui("card.open")}</a></span></div>
    </div>
  </div>
</dialog>
</lesson-preview>
<script>
  import "../../elements/lesson-preview";
</script>
