---
// A closer look at a lesson without leaving the collection: the machine large, the lede, the five experiments.
// Filled in by scripts/collection.ts from the search index, which it fetches the first time a preview opens.
import { useUi } from "../../i18n/ui";
import type { Locale } from "../../i18n";

interface Props { locale: Locale }
const ui = useUi(Astro.props.locale);
---
<dialog id="preview" aria-labelledby="dlg-title">
  <div class="dlg">
    <div class="dlg-shot"><span class="plate-corner tl" data-d="no"></span><span class="plate-corner tr" data-d="machine"></span><img class="on-light" data-d="light" alt="" /><img class="on-dark" data-d="dark" alt="" /></div>
    <div class="dlg-text">
      <div class="meta"><span data-d="area"></span><span data-d="concept"></span></div>
      <h2 id="dlg-title" data-d="title"></h2>
      <p data-d="lede"></p>
      <ol data-d="exps"></ol>
      <div class="dlg-actions"><span class="counts" data-d="counts"></span><span class="card-actions"><button type="button" class="btn" data-close>{ui("dialog.close")}</button><a class="btn primary" data-d="url">{ui("card.open")}</a></span></div>
    </div>
  </div>
</dialog>
