---
// The collection's search and area filters (role="search"): Astryx's PowerSearch (text plus filters as tokens: area,
// title, machine, experiments, questions, lesson number; src/lib/lesson-filters.ts) with the "/" shortcut shown as a
// Kbd, and the area chips, a SegmentedControl kept in step with the Area token.
//
// The chips are a single choice, "All" or one area: Astryx's SegmentedControl (a radiogroup, one Tab stop, ← → / Home
// / End select, the "← → to navigate" hint). When the search holds several areas (or "Area is not …"), no chip is
// checked. Each chip shows how many lessons it would show (data-count, drawn by collection.css, so it is part of the
// chip's name: "Data 12"). The strip scrolls sideways when the chips don't fit, with ‹ › buttons (Astryx Buttons).
//
// Before first paint, the inline script after the strip checks the chip the URL asks for (markArea, writing the same
// attributes <ax-segmented-control> keeps: aria-checked, data-selected, tabindex and the overlay class) and measures
// the strip (measureStrip: the ‹ › buttons and the fades), so the first paint is the settled one
// (src/elements/filter-strip.ts). <lesson-collection> keeps both in step afterwards. Without JavaScript the chips
// can't filter (they never could) and the page lists every lesson.
import PowerSearch from "astryx-astro/components/PowerSearch/PowerSearch.astro";
import Kbd from "astryx-astro/components/Kbd/Kbd.astro";
import SegmentedControl from "astryx-astro/components/SegmentedControl/SegmentedControl.astro";
import SegmentedControlItem from "astryx-astro/components/SegmentedControl/SegmentedControlItem.astro";
import Button from "astryx-astro/components/Button/Button.astro";
import { useUi, AREAS, AREA_NAMES } from "../../i18n/ui";
import { lessonFilters } from "../../lib/lesson-filters";
import type { Locale } from "../../i18n";
import type { Lesson } from "../../lib/lessons";
import { markArea, measureStrip } from "../../elements/filter-strip";

interface Props { locale: Locale; lessons: Lesson[] }
const { locale, lessons } = Astro.props;
const ui = useUi(locale);
const counts = Object.fromEntries(AREAS.map((a) => [a, lessons.filter((l) => l.area === a).length]));
const areas = AREAS.filter((a) => counts[a] > 0);
---
<div class="tools" role="search">
  <PowerSearch
    id="lesson-search"
    config={lessonFilters(locale, areas, lessons.length)}
    label={ui("search.label")}
    placeholder={ui("search.placeholder")}
    startIcon="search"
    maxTokenLength={32}
    maxSearchResults={10}
    locale={locale}
  >
    <Kbd slot="endContent" keys="/" class="search-kbd" />
  </PowerSearch>
  <div class="filters-wrap">
    <Button class="scroll-btn" data-scroll="-1" label={ui("filters.left")} icon="chevronLeft" isIconOnly aria-controls="area-filters" />
    <div class="filters-view">
      <div class="filters">
        <SegmentedControl id="area-filters" value="all" label={ui("filters.label")} locale={locale}>
          <SegmentedControlItem value="all" label={ui("filters.all")} data-count={lessons.length} />
          {areas.map((a) => <SegmentedControlItem value={a} label={AREA_NAMES[a][locale]} data-count={counts[a]} />)}
        </SegmentedControl>
      </div>
    </div>
    <Button class="scroll-btn" data-scroll="1" label={ui("filters.right")} icon="chevronRight" isIconOnly aria-controls="area-filters" />
  </div>
  <script is:inline set:html={`(function(w){(${markArea})(w);(${measureStrip})(w)})(document.currentScript.previousElementSibling)`} />
</div>
<p class="status" id="search-status" role="status" data-status></p>
