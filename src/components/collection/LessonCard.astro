---
// One lesson on the collection page: the running machine's preview (light and dark), what it teaches, and links.
// Previews go through astro:assets, so each is served at the width the layout needs. The first cards' previews load
// at once (they are on screen); the rest load lazily. Each fades in once it has loaded instead of popping in.
//
// The card is a clickable card (Astryx's ClickableCard with an href), built with no script: the title is the card's
// one link, and its ::after stretches over the whole card, so a press anywhere on it follows that real link (middle
// click and Cmd / Ctrl-click open a new tab, as on any link). The focus ring is drawn on the card while the link has
// keyboard focus. The Preview button and Open lesson sit above the stretched link and keep their own behaviour and
// Tab stops; Preview needs JavaScript, so it shows only when scripts run.
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { pick, type Locale } from "../../i18n";
import { useUi, AREA_NAMES } from "../../i18n/ui";
import { two, conceptOf, machineOf, blurbOf, plain, type Lesson } from "../../lib/lessons";

interface Props { lesson: Lesson; locale: Locale; eager?: boolean }
const { lesson: l, locale, eager = false } = Astro.props;
const ui = useUi(locale);
const previews = import.meta.glob<{ default: ImageMetadata }>("/workbench/collection/previews/*.webp", { eager: true });
const img = (scheme: "light" | "dark") => previews[`/workbench/collection/previews/${l.slug}-${scheme}.webp`]?.default;
const title = plain(l.page.title, locale);
const machine = pick(machineOf(l), locale);
const sizes = "(max-width: 760px) calc(100vw - 32px), 540px";
const widths = [400, 560, 800, 1100];
const load = eager ? { loading: "eager" as const, fetchpriority: "high" as const } : { loading: "lazy" as const };
const shown = "this.dataset.loaded=''";
const href = getRelativeLocaleUrl(locale, `lessons/${l.slug}/`);
const id = `lesson-${two(l.n)}`;
---
<article class="card" data-area={l.area} data-slug={l.slug} id={id}>
  <div class="shot">
    {img("light") && <Image class="on-light" src={img("light")!} alt={ui("card.alt", { machine, title })} widths={widths} sizes={sizes} {...load} onload={shown} />}
    {img("dark") && <Image class="on-dark" src={img("dark")!} alt="" widths={widths} sizes={sizes} {...load} onload={shown} />}
    <span class="plate-corner tl">{ui("card.lesson")} {two(l.n)}</span>
    <span class="plate-corner tr">{machine}</span>
  </div>
  <div class="card-body">
    <div class="meta"><span>{AREA_NAMES[l.area][locale]}</span><span>{pick(conceptOf(l), locale)}</span></div>
    <h2 id={`${id}-title`} title={title}><a class="card-link" href={href}>{title}</a></h2>
    <p>{pick(blurbOf(l), locale)}</p>
    <div class="hit" hidden></div>
    <div class="card-foot">
      <span class="counts">{ui("card.counts", { e: l.page.predict.experiments.length, q: l.page.explain.questions.length })}</span>
      <span class="card-actions">
        <button type="button" class="btn" data-preview={l.slug} aria-label={`${ui("card.previewOf")} ${title}`}>{ui("card.preview")}</button>
        <a class="btn primary" href={href} aria-describedby={`${id}-title`}>{ui("card.open")}</a>
      </span>
    </div>
  </div>
</article>
