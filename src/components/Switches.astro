---
// The language links (EN / ES) and the theme switch (Auto / Light / Dark), on every page, built from astryx-astro
// components (behaviour: elements/site-switches.ts; look: styles/switches.css).
// - Language: part of the URL, so each is an Astryx Link to this page in that language, the current one marked
//   aria-current="page". In a page's top navigation they are a labelled group; on their own they are a <nav>
//   landmark (nav={false|true}).
// - Theme: an Astryx SegmentedControl: role="radiogroup" of role="radio" buttons, one Tab stop, ← → / Home / End move
//   and select, the "← → to navigate" hint once. The choice is remembered in this browser. Auto is selected in the
//   HTML (no stored choice: the page follows the device); markTheme, inlined right after the markup, selects the
//   stored one before the first paint, writing the same attributes the SegmentedControl renders.
import { getRelativeLocaleUrl } from "astro:i18n";
import Link from "astryx-astro/components/Link/Link.astro";
import SegmentedControl from "astryx-astro/components/SegmentedControl/SegmentedControl.astro";
import SegmentedControlItem from "astryx-astro/components/SegmentedControl/SegmentedControlItem.astro";
import { LOCALES, type Locale } from "../i18n";
import { useUi } from "../i18n/ui";
import "../styles/switches.css";
import { markTheme } from "../elements/site-switches";

interface Props {
  locale: Locale;
  path: string;
  /** sm: 28px segments (lesson pages); md: 32px (the collection). */
  size?: "sm" | "md";
  /** The language links as their own navigation landmark (false inside a page's top <nav>). */
  nav?: boolean;
}
const { locale, path, size = "sm", nav = true } = Astro.props;
const ui = useUi(locale);
const Lang = nav ? "nav" : "div";
const choices = [["auto", "Auto"], ["light", ui("theme.light")], ["dark", ui("theme.dark")]] as const;
---
<site-switches class="switches" data-size={size}>
  <Lang class="sw-lang" role={nav ? undefined : "group"} aria-label={ui("lang.label")}>
    {LOCALES.map((l) => (
      <Link class="ux-hit" href={getRelativeLocaleUrl(l, path)} hreflang={l} lang={l} aria-current={l === locale ? "page" : undefined} data-lang-link={l} color="inherit" type="inherit">{l.toUpperCase()}</Link>
    ))}
  </Lang>
  <SegmentedControl class="sw-theme" label={ui("theme.label")} value="auto" size={size}>
    {choices.map(([value, label]) => <SegmentedControlItem class="ux-hit" value={value} label={label} />)}
  </SegmentedControl>
</site-switches>
<script is:inline set:html={`(${markTheme})(document.currentScript.previousElementSibling)`} />
<script>
  import "../elements/site-switches";
</script>
