---
// Language links (EN / ES) and the theme switch (Auto / Light / Dark). The language is part of the URL, so
// switching is a link to the same page in the other language; the theme is remembered in this browser. The switches
// mark the current theme while the page is parsed (markTheme in elements/site-switches.ts), before the first paint.
import { getRelativeLocaleUrl } from "astro:i18n";
import { LOCALES, type Locale } from "../i18n";
import { useUi } from "../i18n/ui";
import "../styles/switches.css";
import { markTheme } from "../elements/site-switches";

interface Props { locale: Locale; path: string; class?: string }
const { locale, path, class: className = "switches" } = Astro.props;
const ui = useUi(locale);
---
<site-switches class={className}>
  <nav class="seg lang-seg" aria-label={ui("lang.label")}>
    {LOCALES.map((l) => (
      <a href={getRelativeLocaleUrl(l, path)} hreflang={l} lang={l} aria-current={l === locale ? "page" : undefined} data-lang-link={l}>{l.toUpperCase()}</a>
    ))}
  </nav>
  <div class="seg theme-seg" role="group" aria-label={ui("theme.label")}>
    <button type="button" data-theme-choice="auto">Auto</button>
    <button type="button" data-theme-choice="light">{ui("theme.light")}</button>
    <button type="button" data-theme-choice="dark">{ui("theme.dark")}</button>
  </div>
</site-switches>
<script is:inline set:html={`(${markTheme})(document.currentScript.previousElementSibling)`} />
<script>
  import "../elements/site-switches";
</script>
